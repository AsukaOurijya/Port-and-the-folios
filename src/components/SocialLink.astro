---
import { Icon } from "astro-icon/components";

interface Props {
  href: string;
  label: string;
  icon: string;
}

const { href, label, icon } = Astro.props;
---

<a
  href={href}
  aria-label={label}
  target="_blank"
  rel="noopener noreferrer"
  class="flex size-20 shrink-0 items-center justify-center
         rounded-full bg-background text-white
         transition-colors hover:bg-nav
         focus-visible:outline-2 focus-visible:outline-offset-4
         focus-visible:outline-white sm:size-24"
>
  <Icon
    name={icon}
    aria-hidden="true"
    class="size-10 sm:size-12"
  />
</a>