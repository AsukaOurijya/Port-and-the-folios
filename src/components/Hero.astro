---
import SocialLinks from "./SocialLinks.astro";

const name = "Muhammad Azka Awliya";
const subtitle = " A computer science student";
---

<section 
    aria-labelledby="hero-title"
    class="flex w-full min-h-[65vh] items-center justify-center bg-surface px-6 py-12 text-center"
>

<div class="mx-auto w-full max-w-7xl">
    <p class="mb-2 text-2xl font-bold sm:text-3xl">
        Hello, World!
    </p>

    <h1 id="hero-title" class="text-4xl leading-tight font-bold sm:text-6xl lg:text-7xl xl:text-8xl">
        {name} 
    </h1>

    <p class="mt-3 text-xl font-bold sm:text-3xl">
        {subtitle}
    </p>

    <!-- Row for social icons -->
     <div class="mt-8 sm:mt-10">
        <SocialLinks />
     </div>
</div>

</section>