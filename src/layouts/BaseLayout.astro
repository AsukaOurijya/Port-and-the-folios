---
import "../styles/global.css";

interface Props {
  title?: string;
}

const {title = "akz.dev | Portfolio"} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Comic+Neue:wght@400;700&display=swap"
          rel="stylesheet"
    />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta 
      name="description"
      content="Muhammad Azka Awliya's personal portfolio"
    />
    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-background font-comic text-white">
    <slot />
  </body>
</html>



